#!/usr/bin/env bash
# Mac side of the agterm status bridge, run by launchd (cc-agterm-remote.bridge).
#
# Tails each server's ~/.cache/cc-agterm-remote/status.jsonl, which the
# cc-remote-status hook appends to, over one persistent ssh connection per
# server, and paints the agterm agent-status glyph on whichever local pane is
# showing that remote session. The pane mapping is written by
# `cc-remote-attach`, keyed "<host>:<id>" (a bare id is the legacy host's, see
# cc-remote-config). Each server's connection reconnects on its own, so one
# that is down leaves the others alone.
#
# The same connections carry the Mac clipboard and link opening to the servers:
# each forwards its server's ~/.cache/cc-agterm-remote/clipboard.sock to the
# local socket cc-remote-clipboard answers on (see there).
#
#   cc-remote-bridge          run in the foreground (Ctrl+C to stop)
#   cc-remote-bridge --once   print the configuration and pane map, then exit
#
# Why a journal instead of forwarding AGTERM_* over ssh: a phone-started session
# and a `claude --bg` daemon have no AGTERM_* at all, and a daemon keeps the env
# of whatever pane spawned it. Mapping on this side is the only thing that
# survives detach and reattach.
set -uo pipefail
# shellcheck source=cc-remote-config
. "$(dirname "$0")/cc-remote-config"
need_host

LIVE="$STATE/live-panes.json"

mkdir -p "$STATE"
[ -f "$MAP" ] || printf '{}\n' > "$MAP"
printf '{}\n' > "$LIVE"

paint() {
    local host="$1" sid="$2" state="$3" target="${4:-}" tmp
    # A pane the hook reported itself (CC_REMOTE_PANE, set in plain ssh panes)
    # wins — that is how a claude started BY HAND inside an ssh session, which
    # appears in no map, still lights up. Otherwise look the session up on its
    # host: exact key first, then the 8-char short id, which is the UUID's
    # first block.
    if [ -z "$target" ]; then
        target="$(map_pane "$host" "$sid")"
    fi
    if [ -z "$target" ]; then
        target="$(map_pane "$host" "${sid:0:8}")"
    fi
    [ -n "$target" ] || return 0

    # Remember pane-reported sessions (a claude started by hand in an ssh pane)
    # so sync_names can mark the pane while it runs and un-mark it when it exits.
    if [ -n "${4:-}" ]; then
        tmp="$(mktemp)"
        jq --arg s "$(map_key "$host" "$sid")" --arg p "$target" '. + {($s): $p}' "$LIVE" > "$tmp" 2>/dev/null && mv "$tmp" "$LIVE"
    fi

    case "$state" in
        # Same flags the local agterm hooks use, so remote panes behave identically.
        blocked)   "$AGTERMCTL" session status blocked   --target "$target" --blink >/dev/null 2>&1 ;;
        completed) "$AGTERMCTL" session status completed --target "$target" --auto-reset >/dev/null 2>&1 ;;
        active)    "$AGTERMCTL" session status active    --target "$target" --blink >/dev/null 2>&1 ;;
        idle)      "$AGTERMCTL" session status idle      --target "$target" >/dev/null 2>&1 ;;
    esac
}

if [ "${1:-}" = "--once" ]; then
    echo "config:    $CC_REMOTE_CONFIG"
    echo "hosts:     ${HOSTS[*]} (entries without a host: $LEGACY_HOST)"
    echo "marks:     $(mark_legend)"
    [ -z "$MARK_ERRORS" ] || printf '  %s\n' "$MARK_ERRORS"
    echo "agtermctl: $AGTERMCTL"
    echo "map:       $MAP ($(jq -r 'length' "$MAP" 2>/dev/null) entries)"
    jq -r 'to_entries[] | "  \(.key) -> \(.value)"' "$MAP" 2>/dev/null
    exit 0
fi

echo "bridging ~/$REMOTE_STATE/status.jsonl on ${HOSTS[*]} -> agterm (map: $MAP)"

# The entries of pane-map file $2 (map.json or live-panes.json) that belong to
# host $1, as "id<TAB>pane": its "<host>:<id>" keys, and the keys without a
# host when it is the legacy host.
host_entries() {
    local bare=false
    [ "$1" = "$LEGACY_HOST" ] && bare=true
    jq -r --arg p "$(map_key "$1" "")" --argjson bare "$bare" '
        to_entries[]
        | if (.key | startswith($p)) then "\(.key | ltrimstr($p))\t\(.value)"
          elif $bare and (.key | test(":") | not) then "\(.key)\t\(.value)"
          else empty end' "$2" 2>/dev/null
}

# Claude Code names a session itself after the first prompt, and that name never
# reaches the terminal title through `claude attach`. Poll for it and relabel the
# pane (pane_label: "<host mark> ✳ <name>") so the sidebar shows Claude's name
# rather than the one set at launch. A pane whose session has no name yet keeps
# its name with the host's current mark in front, which re-marks a pane named
# before the marks changed.
sync_names() {
    local h
    while :; do
        sleep 60
        for h in "${HOSTS[@]}"; do sync_host "$h"; done
    done
}

# Rename agterm pane $1 to $2, unless it is gone or already has that name, from
# the {pane: name} JSON in $3.
rename_pane() {
    local cur
    cur="$(jq -r --arg p "$1" 'if has($p) then "+" + .[$p] else "-" end' <<<"$3" 2>/dev/null)"
    case "$cur" in "+$2"|"-"|"") return 0 ;; esac
    "$AGTERMCTL" session rename "$2" --target "$1" >/dev/null 2>&1
}

# One pass of sync_names for host $1, which is skipped while it is down.
sync_host() {
    local h="$1" agents panes sid pane name cur tmp seen=" "
    agents="$(ssh "${SSH_QUICK[@]}" "$h" 'export PATH="$HOME/.local/bin:$PATH"; claude agents --json' 2>/dev/null)" || return 0
    [ -n "$agents" ] || return 0
    panes="$("$AGTERMCTL" tree --json 2>/dev/null |
             jq -c '[.result.tree.workspaces[].sessions[] | {key: .id, value: (.name // "")}] | from_entries' 2>/dev/null)"
    [ -n "$panes" ] || return 0
    # A pane is mapped under its session's short id and its uuid: one pass each.
    while IFS=$'\t' read -r sid pane; do
        [ -n "$sid" ] && [ -n "$pane" ] || continue
        case "$seen" in *" $pane "*) continue ;; esac
        seen="$seen$pane "
        name="$(jq -r --arg s "$sid" \
            '.[] | select(.sessionId == $s or .id == $s) | .name // empty' <<<"$agents" 2>/dev/null | head -1)"
        if [ -z "$name" ] || [ "$name" = "$sid" ]; then
            cur="$(jq -r --arg p "$pane" '.[$p] // empty' <<<"$panes")"
            has_mark "$cur" || continue
            name="$cur"
        fi
        rename_pane "$pane" "$(pane_label "$h" "$name")" "$panes"
    done < <(host_entries "$h" "$MAP")

    # Panes running a hand-started claude: Claude Code overwrites the shell's
    # OSC title with its own "✳ <name>", losing the remote mark. Re-mark them
    # while the session lives, and un-name the pane once it is gone so it
    # goes back to following the shell title ("<host mark> ~/dir").
    while IFS=$'\t' read -r sid pane; do
        [ -n "$sid" ] && [ -n "$pane" ] || continue
        name="$(jq -r --arg s "$sid" \
            '.[] | select(.sessionId == $s) | .name // empty' <<<"$agents" 2>/dev/null | head -1)"
        if [ -n "$name" ]; then
            rename_pane "$pane" "$(pane_label "$h" "$name")" "$panes"
        else
            "$AGTERMCTL" session rename "" --target "$pane" >/dev/null 2>&1
            tmp="$(mktemp)"
            jq --arg s "$(map_key "$h" "$sid")" 'del(.[$s])' "$LIVE" > "$tmp" 2>/dev/null && mv "$tmp" "$LIVE"
        fi
    done < <(host_entries "$h" "$LIVE")
}

# One server's status tail and clipboard forward, reconnecting forever.
bridge_host() {
    local h="$1" id rhome forward line sid state pane
    while :; do
        # Each connection forwards its own socket, clipboard.<id>.sock, and points
        # the clipboard.sock link the server's scripts use at it once it is up. One
        # fixed path would break: sshd unlinks a forwarded socket when that
        # connection ends, and an old connection the server notices dead only later
        # would delete the path the new one had just bound.
        #
        # First, over a short connection: make the directory (owner only), drop
        # sockets of connections that are gone (nothing answers on them), and learn
        # the remote home, since a forwarded socket path must be absolute.
        id="$$-$(date +%s)"
        rhome="$(ssh -o ConnectTimeout=10 "$h" "mkdir -p ~/$REMOTE_STATE && chmod 700 ~/$REMOTE_STATE &&
            for s in ~/$REMOTE_STATE/clipboard.*.sock; do
                [ -S \"\$s\" ] && command -v nc >/dev/null && ! nc -z -U \"\$s\" 2>/dev/null && rm -f \"\$s\"
            done; printf %s \"\$HOME\"" 2>/dev/null)"
        if [ -n "$rhome" ]; then
            forward=(-R "$rhome/$REMOTE_STATE/clipboard.$id.sock:$CLIPBOARD_SOCK")
            # A failed forward only loses the clipboard; the status tail keeps running.
            ssh -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ConnectTimeout=10 -o ExitOnForwardFailure=no \
                "${forward[@]}" "$h" \
                "ln -sfn clipboard.$id.sock ~/$REMOTE_STATE/clipboard.sock; touch ~/$REMOTE_STATE/status.jsonl; tail -F -n0 ~/$REMOTE_STATE/status.jsonl" 2>/dev/null |
            while IFS= read -r line; do
                sid="$(jq -r '.session_id // empty' <<<"$line" 2>/dev/null)"
                state="$(jq -r '.state // empty' <<<"$line" 2>/dev/null)"
                pane="$(jq -r '.pane // empty' <<<"$line" 2>/dev/null)"
                [ -n "$sid" ] && [ -n "$state" ] && paint "$h" "$sid" "$state" "$pane"
            done
        fi
        echo "$h: connection dropped, reconnecting in 10s" >&2
        sleep 10
    done
}

sync_names &
for h in "${HOSTS[@]}"; do bridge_host "$h" & done
# The loops run until this process goes; launchd stops it with SIGTERM.
trap 'kill $(jobs -p) 2>/dev/null' EXIT
trap 'exit 0' TERM INT
wait
